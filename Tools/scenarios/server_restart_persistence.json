  ],
  "clients": [
    { "name": "Rex", "server": 0, "autotest": "restart.first", "graphics": false, "args": ["-set-cash", "4242"] },
    { "name": "RexAgain", "profile": "Rex", "server": 1, "startAfterInGame": ["Rex"], "delaySec": 5, "autotest": "persist.check", "graphics": false,
      "args": ["-expect-cash", "4242", "-expect-items", "test.rock=2"] }
  ]
}
