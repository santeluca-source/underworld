{
  "description": "First entra e riceve $7,777; lo stesso giocatore entra da un secondo client: First viene scollegato con session_replaced, Second entra con $7,777 (dati intatti).",
  "timeoutSec": 120,
  "servers": [
    { "area": "TestGround", "autotest": "replaced.server", "args": ["-testmode", "-expect-cash", "7777"] }
