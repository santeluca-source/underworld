# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
# Recommended: add any editor/OS/tool-specific ignore rules from the Global/ templates as needed.
# See: https://github.com/github/gitignore/tree/main/Global
#
.utmp/
/UnityProject/[Ll]ibrary/
/UnityProject/[Tt]emp/
/UnityProject/[Oo]bj/
/UnityProject/[Bb]uild/
/UnityProject/[Bb]uilds/
/UnityProject/[Ll]ogs/
/UnityProject/[Uu]ser[Ss]ettings/
*.log

# Memory Profiler generated files
# MemoryCaptures can get excessive in size
# They also could contain extremely sensitive data
/UnityProject/[Mm]emory[Cc]aptures/

# Recordings can get excessive in size
/UnityProject/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/UnityProject/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vsconfig

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
.dirstamp
mono_crash.*
tmpinst-dir.stamp

# Builds
/*_BackUpThisFolder_ButDontShipItWithYourGame/
/*_BurstDebugInformation_DoNotShip/
*.apk
*.aab
*.obb
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# Blender generated backup files
/UnityProject/[Aa]ssets/**/*.blend1
/UnityProject/[Aa]ssets/**/*.blend1.meta

# TouchDesigner generated cache files
/UnityProject/[Aa]ssets/**/TDImportCache/
/UnityProject/[Aa]ssets/**/TDImportCache.meta

# Unity Crash Recovery generated files
/UnityProject/[Aa]ssets/_Recovery/
/UnityProject/[Aa]ssets/_Recovery.meta

# Addressables default ignores, before user customizations
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin
/UnityProject/[Aa]ssets/AddressableAssetsData/*/addressables_content_state.bin
/UnityProject/[Aa]ssets/AddressableAssetsData/*/addressables_content_state.bin.meta
/UnityProject/[Aa]ssets/AddressableAssetsData/link.xml
/UnityProject/[Aa]ssets/AddressableAssetsData/link.xml.meta
/UnityProject/[Aa]ssets/Addressables_Temp/
/UnityProject/[Aa]ssets/Addressables_Temp.meta
/UnityProject/[Aa]ssets/StreamingAssets/aa/
/UnityProject/[Aa]ssets/StreamingAssets/aa.meta
/ServerData/

# EDM4U generated files
/UnityProject/[Aa]ssets/GeneratedLocalRepo/
/UnityProject/[Aa]ssets/GeneratedLocalRepo.meta

# Android Gradle generated files
/UnityProject/[Aa]ssets/Plugins/Android/**/*.gradle.backup*
/UnityProject/[Aa]ssets/Plugins/Android/**/local.properties

# Test Framework generated files
/UnityProject/[Aa]ssets/Resources/PerformanceTestRunInfo.json
/UnityProject/[Aa]ssets/Resources/PerformanceTestRunInfo.json.meta
/UnityProject/[Aa]ssets/Resources/PerformanceTestRunSettings.json
/UnityProject/[Aa]ssets/Resources/PerformanceTestRunSettings.json.meta
/UnityProject/[Aa]ssets/InitTestScene*.unity
/UnityProject/[Aa]ssets/InitTestScene*.unity.meta

# Visual Scripting auto-generated files
/UnityProject/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers/
/UnityProject/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta
/UnityProject/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/UnityProject/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta

# UI Toolkit auto generated files
/UIElementsSchema/

# Auto-generated cache in Assets folder
/UnityProject/[Aa]ssets/[Ss]ceneDependencyCache*

# .NET
bin/
obj/
.vs/
.env
